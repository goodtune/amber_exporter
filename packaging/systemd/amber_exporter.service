[Unit]
Description=Amber Exporter - Prometheus exporter for Amber Electric
Documentation=https://github.com/goodtune/amber_exporter
Wants=network-online.target
After=network-online.target

[Service]
# The file sets AMBER_API_KEY and AMBER_EXPORTER_ARGS. systemd reads it as
# root before it starts the service, so only root needs to read the file.
EnvironmentFile=/etc/amber_exporter/environment
ExecStart=/usr/bin/amber_exporter $AMBER_EXPORTER_ARGS

DynamicUser=yes

Restart=on-failure
RestartSec=5s
# Exit status 2 means that the API key is missing. A restart does not help.
RestartPreventExitStatus=2

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
